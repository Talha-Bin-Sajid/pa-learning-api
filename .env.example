# ---------------------------------------------------------------
# Project Accountants Learning Platform - backend configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (the React app).
CORS_ORIGINS=http://localhost:5173
# Set to true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# --- Database (Supabase → Connect → Session pooler connection string) ---
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
# require = TLS (Supabase default) | verify = TLS + CA check | disable = local only
DATABASE_SSL=require
DATABASE_POOL_MAX=10

# --- Supabase (Project Settings → API Keys / Data API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# SECRET: service_role / secret key. Backend only - never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only for older projects using the legacy HS256 JWT secret. Leave empty to use JWKS (default).
SUPABASE_JWT_SECRET=
EVIDENCE_BUCKET=evidence

# --- Application ---
# Comma-separated domains allowed to self-register; empty = any.
ALLOWED_EMAIL_DOMAINS=projectaccountants.co.uk
APP_TIMEZONE=Europe/London
APP_BASE_URL=http://localhost:5173

# --- Email for reminders (optional until reminders are used) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Project Accountants Learning <learning@projectaccountants.co.uk>
REMINDER_SCHEDULER_ENABLED=false

# --- Automatic evidence checks (Google Gemini) - see docs/adr/0005 ---
# Get a key at https://aistudio.google.com/apikey. Use a PAID (billing-enabled) key for real
# certificates: on the free tier Google may use submitted content to improve its products.
AI_VERIFICATION_ENABLED=false
GEMINI_API_KEY=
# Any Gemini model that reads PDFs/images; `npm run check:setup` lists what your key can use.
GEMINI_MODEL=gemini-flash-latest
# Used straight away when the main model is overloaded (HTTP 503/429). Comma-separated; empty = none.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Below this confidence (0-1) evidence always goes to the Learning Team.
AI_MIN_CONFIDENCE=0.8
# Allowed gap (days) between the certificate date and the completion date entered.
AI_DATE_TOLERANCE_DAYS=14
# Attempts before handing over to the Learning Team; retries wait 1, 3, 10, 20, 30, 30 min (~1.5 h in total).
AI_MAX_ATTEMPTS=7
